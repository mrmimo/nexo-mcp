<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NexoMcp.Server</AssemblyName>

    <!--
      Path to the InsERT nexo SDK's Bin folder, which holds the proprietary Sfera assemblies
      this project references below. Those DLLs come from your own licensed nexo installation
      and are never part of this repository (see README.md "Konfiguracja" / "Setup") - point
      this at them either by setting the NEXO_SDK_PATH environment variable, or by copying the
      DLLs into a local "sdk/" folder at the repo root (gitignored).
    -->
    <NexoSdkBinPath Condition="'$(NexoSdkBinPath)' == '' and '$(NEXO_SDK_PATH)' != ''">$(NEXO_SDK_PATH)</NexoSdkBinPath>
    <NexoSdkBinPath Condition="'$(NexoSdkBinPath)' == ''">$(MSBuildThisFileDirectory)..\..\sdk\</NexoSdkBinPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexoMcp.Core\NexoMcp.Core.csproj" />
  </ItemGroup>

  <!--
    Proprietary InsERT nexo SDK references - NOT shipped in this repo (no license to redistribute
    them). See the NexoSdkBinPath property above for where this build expects to find them.
  -->
  <ItemGroup>
    <Reference Include="InsERT.Moria.API">
      <HintPath>$(NexoSdkBinPath)InsERT.Moria.API.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.DaneDomyslne">
      <HintPath>$(NexoSdkBinPath)InsERT.Moria.DaneDomyslne.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.ModelDanych">
      <HintPath>$(NexoSdkBinPath)InsERT.Moria.ModelDanych.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Moria.Sfera">
      <HintPath>$(NexoSdkBinPath)InsERT.Moria.Sfera.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.Core">
      <HintPath>$(NexoSdkBinPath)InsERT.Mox.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFramework.Core">
      <HintPath>$(NexoSdkBinPath)InsERT.Mox.EntityFramework.Core.dll</HintPath>
    </Reference>
    <Reference Include="InsERT.Mox.EntityFrameworkSupport">
      <HintPath>$(NexoSdkBinPath)InsERT.Mox.EntityFrameworkSupport.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Sfera loads a chunk of the rest of the nexo SDK's Bin folder dynamically at runtime (plugin
    host style - e.g. InsERT.Mox.Launcher.dll is pulled in by DanePolaczenia.Jawne even though no
    code here references it directly), not just the assemblies referenced above. Rather than
    chase each missing dependency one at a time, copy every DLL/.pak file from the SDK's Bin
    folder next to this project's own build output.
  -->
  <Target Name="CopyNexoSdkRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <NexoSdkRuntimeFile Include="$(NexoSdkBinPath)*.dll" />
      <NexoSdkRuntimeFile Include="$(NexoSdkBinPath)*.pak" />
    </ItemGroup>
    <Copy SourceFiles="@(NexoSdkRuntimeFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
