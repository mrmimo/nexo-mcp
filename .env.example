# Copy this file to .env (or set the same variables in your MCP client's server config) and
# fill in your own values. Never commit a real .env file - it is already in .gitignore.

# SQL Server instance hosting your nexo company database, e.g. "(local)\INSERTNEXO" or a
# network name. Required.
NEXO_SERVER=(local)\INSERTNEXO

# Name of your nexo company database. Required.
NEXO_DATABASE=

# true (default) to connect with Windows authentication (the account running this process must
# be one nexo already trusts). Set to false to use an explicit nexo operator login below instead.
NEXO_WINDOWS_AUTH=true

# Only used when NEXO_WINDOWS_AUTH=false.
NEXO_LOGIN=
NEXO_PASSWORD=

# Which InsERT product license to connect as (affects available modules, not whether sales
# invoices can be read) - typically "Subiekt" or "Gestor". See your nexo SDK's ProductId enum
# for the full list of values.
NEXO_PRODUCT_ID=Subiekt

# Where the local invoice cache (SQLite) is kept. Relative paths are relative to the working
# directory the server is started from.
NEXO_MCP_CACHE_PATH=cache/invoices.db

# How often (minutes) the server re-syncs invoices from nexo in the background.
NEXO_MCP_SYNC_INTERVAL_MINUTES=60
