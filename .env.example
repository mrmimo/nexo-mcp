# Skopiuj ten plik do .env (albo ustaw te same zmienne w konfiguracji serwera w swoim kliencie
# MCP) i wypełnij własnymi wartościami. Nigdy nie commituj prawdziwego pliku .env - jest już w
# .gitignore.

# Instancja SQL Server, na której stoi Twoja baza firmowa nexo, np. "(local)\INSERTNEXO" albo
# nazwa sieciowa. Wymagane.
NEXO_SERVER=(local)\INSERTNEXO

# Nazwa Twojej bazy firmowej nexo. Wymagane.
NEXO_DATABASE=

# true (domyślnie) łączy z SQL Serverem przez autentykację Windows (konto, na którym działa ten
# proces, musi być kontem, któremu SQL Server już ufa); false łączy loginem/hasłem podanym niżej
# (NEXO_SQL_LOGIN/NEXO_SQL_PASSWORD). Dotyczy TYLKO połączenia z SQL Serverem - nie ma związku
# z NEXO_LOGIN niżej.
NEXO_WINDOWS_AUTH=true

# Login/hasło do SQL Servera - wymagane TYLKO gdy NEXO_WINDOWS_AUTH=false. To inny login niż
# NEXO_LOGIN niżej (ten dotyczy połączenia z bazą, nie logowania jako operator nexo).
NEXO_SQL_LOGIN=
NEXO_SQL_PASSWORD=

# Login OPERATORA nexo - WYMAGANY ZAWSZE (to logowanie do Sfery jako użytkownik/operator nexo,
# krok niezależny od połączenia z SQL Serverem powyżej, potrzebny niezależnie od tego, jak
# połączono się z bazą).
NEXO_LOGIN=
NEXO_PASSWORD=

# Jakiej licencji produktu InsERT użyć do połączenia (wpływa na dostępne moduły, nie na to, czy da
# się odczytać faktury sprzedaży) - zazwyczaj "Subiekt" albo "Gestor". Pełna lista wartości jest
# w enumie ProductId w Twoim SDK nexo.
NEXO_PRODUCT_ID=Subiekt

# Gdzie trzymany jest lokalny cache faktur (SQLite). Ścieżka względna jest względna wobec folderu
# z plikiem wykonywalnym serwera (NIE względem katalogu, z którego klient MCP go uruchomił - to
# może być inny folder przy każdym starcie).
NEXO_MCP_CACHE_PATH=cache/invoices.db

# Jak często (w minutach) serwer odświeża dane z nexo w tle.
NEXO_MCP_SYNC_INTERVAL_MINUTES=60
